  "executionStateContract": {
    "schemaVersion": 2,
    "sourceStorage": ".harness/local/execution/execution-status.json",
    "targetStorage": "git-private ai-harness",
    "modes": [
      "single",
      "chain",
      "orchestration"
    ],
    "executionStatuses": [
      "running",
      "complete",
      "blocked"
    ],
    "commandResults": [
      "SUCCESS",
      "PASS",
      "FAIL",
      "BLOCKED"
    ],
    "resolverStatuses": [
      "RESUME",
      "NEXT",
      "DONE",
      "BLOCKED",
      "NOT_FOUND"
    ],
    "bounds": {
      "recentTerminals": 100,
      "currentDetailsBytes": 16384,
      "intentBasisBytes": 16384,
      "progressTelemetrySamples": 8
    },
    "invariants": [
      "nextOrdinal is monotonic and defines latest invocation semantics independently of timestamp collisions",
      "semantic completion is bound to exact executionId so stale results cannot commit a newer invocation",
      "read-modify-write is serialized and JSON replacement is atomic",
      "resume compares saved intent basis with current relevant semantic fingerprints before normal recovery",
      "terminal history is compact bounded handoff state rather than an unbounded transcript"
    ]
  }
